# --- SUNUCU AYARLARI ---

# Sunucunuza dışarıdan bağlanılacak port. (Örn: 25565 doluysa 25570 yapabilirsiniz)
# Oyuncular sunucuya girerken IP_ADRESI:25570 şeklinde bağlanacaktır.
HOST_PORT=25570

# Sunucuya ayrılacak RAM miktarı (Örn: 6G, 8G, 10G)
SERVER_RAM=8G


# --- YEDEKLEME AYARLARI ---

# Yedekleme sıklığı (Saniye cinsinden. 43200 = 12 saat, 86400 = 24 saat)
BACKUP_INTERVAL=43200

# Eski yedeklerin kaç gün saklanacağı (Örn: 7 gün)
BACKUP_RETENTION_DAYS=7